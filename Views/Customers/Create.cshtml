@model AcxiomCRM.ViewModels.CustomerEditViewModel
@{
    ViewData["Title"] = "Add New Customer";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-person-plus-fill text-primary me-2"></i>New Customer Record</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post" id="customerForm">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="CustomerName" class="form-label fw-semibold small required"></label>
                            <input asp-for="CustomerName" class="form-control" placeholder="Acme Corporation" />
                            <span asp-validation-for="CustomerName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CompanyName" class="form-label fw-semibold small required"></label>
                            <input asp-for="CompanyName" class="form-control" placeholder="Acme Global Inc" />
                            <span asp-validation-for="CompanyName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold small required"></label>
                            <input asp-for="Email" class="form-control" placeholder="contact@acme.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label fw-semibold small required"></label>
                            <input asp-for="Phone" class="form-control" placeholder="10-digit mobile number, e.g. 9876543210" maxlength="10" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                            <div class="form-text small">Must be exactly 10 digits.</div>
                        </div>

                        <div class="col-12">
                            <label asp-for="Address" class="form-label fw-semibold small"></label>
                            <input asp-for="Address" class="form-control" placeholder="Suite 400, Commerce Tower" />
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="City" class="form-label fw-semibold small"></label>
                            <input asp-for="City" class="form-control" placeholder="City" />
                            <span asp-validation-for="City" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="State" class="form-label fw-semibold small"></label>
                            <input asp-for="State" class="form-control" placeholder="State/Province" />
                            <span asp-validation-for="State" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Status" class="form-label fw-semibold small"></label>
                            <select asp-for="Status" class="form-select">
                                <option value="Active">Active</option>
                                <option value="Inactive">Inactive</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>

                        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                        {
                            <div class="col-md-12">
                                <label asp-for="OwnerId" class="form-label fw-semibold small"></label>
                                <select asp-for="OwnerId" asp-items="Model.SalesExecutives" class="form-select">
                                    <option value="">-- Assign to Sales Executive --</option>
                                </select>
                                <span asp-validation-for="OwnerId" class="text-danger small"></span>
                            </div>
                        }
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4 fw-semibold">
                            <i class="bi bi-check-lg me-1"></i> Save Customer
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
