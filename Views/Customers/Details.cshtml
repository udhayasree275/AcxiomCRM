@model AcxiomCRM.ViewModels.CustomerDetailViewModel
@{
    ViewData["Title"] = $"{Model.Customer.CustomerName} - Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h2 class="fw-bold mb-0 text-dark">@Model.Customer.CustomerName</h2>
            <span class="badge bg-light text-dark border">@Model.Customer.CustomerCode</span>
            @if (Model.Customer.Status == "Active")
            {
                <span class="badge bg-success">Active</span>
            }
            else
            {
                <span class="badge bg-secondary">Inactive</span>
            }
        </div>
        <div class="text-muted small mt-1">@Model.Customer.CompanyName | Managed by: <strong>@(Model.Customer.Owner?.FullName ?? "Unassigned")</strong></div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Customer.CustomerId" class="btn btn-outline-primary">
            <i class="bi bi-pencil me-1"></i> Edit
        </a>
        <a asp-controller="Opportunities" asp-action="Create" asp-route-customerId="@Model.Customer.CustomerId" class="btn btn-outline-success">
            <i class="bi bi-plus-circle me-1"></i> Add Deal
        </a>
        <a asp-controller="FollowUps" asp-action="Create" asp-route-customerId="@Model.Customer.CustomerId" class="btn btn-outline-info">
            <i class="bi bi-alarm me-1"></i> Follow-Up
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
    </div>
</div>

<!-- Tabs Container -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white border-bottom">
        <ul class="nav nav-tabs card-header-tabs" id="customerTab" role="tablist">
            <li class="nav-item">
                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#overviewTab">Overview &amp; Contact</button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#opportunitiesTab">Opportunities (@Model.Opportunities.Count)</button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#followUpsTab">Follow-Ups (@Model.FollowUps.Count)</button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#activitiesTab">Activity History (@Model.Activities.Count)</button>
            </li>
        </ul>
    </div>
    <div class="card-body p-4">
        <div class="tab-content">
            <!-- Overview Tab -->
            <div class="tab-pane fade show active" id="overviewTab">
                <div class="row g-4">
                    <div class="col-md-6">
                        <h6 class="text-uppercase text-muted fw-bold small mb-3">General Information</h6>
                        <table class="table table-sm table-borderless">
                            <tr>
                                <th class="text-muted w-40">Company Name:</th>
                                <td class="fw-semibold">@Model.Customer.CompanyName</td>
                            </tr>
                            <tr>
                                <th class="text-muted">Email:</th>
                                <td><a href="mailto:@Model.Customer.Email">@Model.Customer.Email</a></td>
                            </tr>
                            <tr>
                                <th class="text-muted">Phone:</th>
                                <td class="fw-semibold">@Model.Customer.Phone</td>
                            </tr>
                            <tr>
                                <th class="text-muted">Created Date:</th>
                                <td>@Model.Customer.CreatedDate.ToString("yyyy-MM-dd HH:mm") UTC</td>
                            </tr>
                            <tr>
                                <th class="text-muted">Created By:</th>
                                <td>@(Model.Customer.CreatedBy ?? "System")</td>
                            </tr>
                        </table>
                    </div>
                    <div class="col-md-6">
                        <h6 class="text-uppercase text-muted fw-bold small mb-3">Address &amp; Location</h6>
                        <table class="table table-sm table-borderless">
                            <tr>
                                <th class="text-muted w-40">Street Address:</th>
                                <td>@(Model.Customer.Address ?? "Not specified")</td>
                            </tr>
                            <tr>
                                <th class="text-muted">City:</th>
                                <td>@(Model.Customer.City ?? "Not specified")</td>
                            </tr>
                            <tr>
                                <th class="text-muted">State:</th>
                                <td>@(Model.Customer.State ?? "Not specified")</td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Opportunities Tab -->
            <div class="tab-pane fade" id="opportunitiesTab">
                @if (!Model.Opportunities.Any())
                {
                    <div class="text-center py-4 text-muted">No opportunities found for this customer.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>Deal Name</th>
                                    <th>Stage</th>
                                    <th>Amount</th>
                                    <th>Probability</th>
                                    <th>Weighted</th>
                                    <th>Expected Close</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var opp in Model.Opportunities)
                                {
                                    <tr>
                                        <td class="fw-semibold">
                                            <a asp-controller="Opportunities" asp-action="Details" asp-route-id="@opp.OpportunityId" class="text-decoration-none">
                                                @opp.OpportunityName
                                            </a>
                                        </td>
                                        <td><span class="badge bg-light text-dark border">@opp.Stage</span></td>
                                        <td class="fw-bold">$@opp.Amount.ToString("N0")</td>
                                        <td>@opp.Probability%</td>
                                        <td class="text-muted">$@opp.WeightedAmount.ToString("N0")</td>
                                        <td>@opp.ExpectedCloseDate.ToString("yyyy-MM-dd")</td>
                                        <td>
                                            @if (opp.Status == "Won") { <span class="badge bg-success">Won</span> }
                                            else if (opp.Status == "Lost") { <span class="badge bg-danger">Lost</span> }
                                            else { <span class="badge bg-primary">Open</span> }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <!-- Follow-Ups Tab -->
            <div class="tab-pane fade" id="followUpsTab">
                @if (!Model.FollowUps.Any())
                {
                    <div class="text-center py-4 text-muted">No follow-ups recorded.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Type</th>
                                    <th>Subject</th>
                                    <th>Remarks</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var fu in Model.FollowUps)
                                {
                                    <tr>
                                        <td>@fu.FollowUpDate.ToString("yyyy-MM-dd HH:mm")</td>
                                        <td><span class="badge bg-secondary">@fu.FollowUpType</span></td>
                                        <td class="fw-semibold">@fu.Subject</td>
                                        <td class="small text-muted">@fu.Remarks</td>
                                        <td>
                                            @if (fu.Status == "Completed") { <span class="badge bg-success">Completed</span> }
                                            else if (fu.Status == "Missed") { <span class="badge bg-danger">Missed</span> }
                                            else { <span class="badge bg-primary">Planned</span> }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <!-- Activities Tab -->
            <div class="tab-pane fade" id="activitiesTab">
                @if (!Model.Activities.Any())
                {
                    <div class="text-center py-4 text-muted">No activities logged.</div>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var act in Model.Activities)
                        {
                            <div class="list-group-item px-0 py-3">
                                <div class="d-flex justify-content-between">
                                    <h6 class="mb-1 fw-bold text-dark"><span class="badge bg-primary me-2">@act.ActivityType</span>@act.Subject</h6>
                                    <small class="text-muted">@act.ActivityDate.ToString("yyyy-MM-dd HH:mm")</small>
                                </div>
                                <p class="mb-1 text-muted small">@act.Description</p>
                                <small class="text-secondary">Assigned: @(act.AssignedUser?.FullName ?? "Unknown") | Status: @act.Status</small>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
