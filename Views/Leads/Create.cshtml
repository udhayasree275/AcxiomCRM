@model AcxiomCRM.ViewModels.LeadEditViewModel
@{
    ViewData["Title"] = "Add New Lead";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-funnel-fill text-primary me-2"></i>New Lead Capture</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="LeadName" class="form-label fw-semibold small required"></label>
                            <input asp-for="LeadName" class="form-control" placeholder="Contact Person Name" />
                            <span asp-validation-for="LeadName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CompanyName" class="form-label fw-semibold small required"></label>
                            <input asp-for="CompanyName" class="form-control" placeholder="Company / Business Name" />
                            <span asp-validation-for="CompanyName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold small required"></label>
                            <input asp-for="Email" class="form-control" placeholder="lead@company.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label fw-semibold small required"></label>
                            <input asp-for="Phone" class="form-control" placeholder="10 digits, e.g. 9876543210" maxlength="10" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Source" class="form-label fw-semibold small required"></label>
                            <select asp-for="Source" class="form-select">
                                <option value="Website">Website</option>
                                <option value="Referral">Referral</option>
                                <option value="Cold Call">Cold Call</option>
                                <option value="Advertisement">Advertisement</option>
                                <option value="Partner">Partner</option>
                                <option value="Other">Other</option>
                            </select>
                            <span asp-validation-for="Source" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Status" class="form-label fw-semibold small required"></label>
                            <select asp-for="Status" class="form-select">
                                <option value="New">New</option>
                                <option value="Contacted">Contacted</option>
                                <option value="Qualified">Qualified</option>
                                <option value="Unqualified">Unqualified</option>
                                <option value="Lost">Lost</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Priority" class="form-label fw-semibold small required"></label>
                            <select asp-for="Priority" class="form-select">
                                <option value="High">High</option>
                                <option value="Medium">Medium</option>
                                <option value="Low">Low</option>
                            </select>
                            <span asp-validation-for="Priority" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ExpectedValue" class="form-label fw-semibold small required"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light">$</span>
                                <input asp-for="ExpectedValue" class="form-control" type="number" step="0.01" min="1" placeholder="25000" />
                            </div>
                            <span asp-validation-for="ExpectedValue" class="text-danger small"></span>
                        </div>

                        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                        {
                            <div class="col-md-6">
                                <label asp-for="AssignedTo" class="form-label fw-semibold small"></label>
                                <select asp-for="AssignedTo" asp-items="Model.SalesExecutives" class="form-select">
                                    <option value="">-- Assign Sales Executive --</option>
                                </select>
                                <span asp-validation-for="AssignedTo" class="text-danger small"></span>
                            </div>
                        }

                        <div class="col-12">
                            <label asp-for="Notes" class="form-label fw-semibold small"></label>
                            <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Capture requirements, background, notes..."></textarea>
                            <span asp-validation-for="Notes" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4 fw-semibold">
                            <i class="bi bi-check-lg me-1"></i> Save Lead
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
