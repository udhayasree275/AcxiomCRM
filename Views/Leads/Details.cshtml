@model AcxiomCRM.ViewModels.LeadDetailViewModel
@{
    ViewData["Title"] = $"{Model.Lead.LeadName} - Lead Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h2 class="fw-bold mb-0 text-dark">@Model.Lead.LeadName</h2>
            <span class="badge bg-light text-dark border">@Model.Lead.LeadCode</span>
            @if (Model.Lead.Status == "Converted")
            {
                <span class="badge bg-success"><i class="bi bi-check-all me-1"></i>Converted</span>
            }
            else
            {
                <span class="badge bg-primary">@Model.Lead.Status</span>
            }
            <span class="badge bg-info text-dark">@Model.Lead.Priority Priority</span>
        </div>
        <div class="text-muted small mt-1">@Model.Lead.CompanyName | Source: @Model.Lead.Source | Assigned: <strong>@(Model.Lead.AssignedUser?.FullName ?? "Unassigned")</strong></div>
    </div>
    <div class="d-flex gap-2">
        @if (Model.Lead.Status != "Converted")
        {
            <a asp-action="Convert" asp-route-id="@Model.Lead.LeadId" class="btn btn-success fw-semibold">
                <i class="bi bi-arrow-repeat me-1"></i> Convert to Customer
            </a>
        }
        else if (Model.Lead.ConvertedCustomerId.HasValue)
        {
            <a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.Lead.ConvertedCustomerId.Value" class="btn btn-outline-success">
                <i class="bi bi-box-arrow-up-right me-1"></i> View Converted Customer
            </a>
        }
        <a asp-action="Edit" asp-route-id="@Model.Lead.LeadId" class="btn btn-outline-primary">
            <i class="bi bi-pencil me-1"></i> Edit
        </a>
        <a asp-controller="FollowUps" asp-action="Create" asp-route-leadId="@Model.Lead.LeadId" class="btn btn-outline-info">
            <i class="bi bi-alarm me-1"></i> Add Follow-Up
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-5">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3 border-bottom">
                <h6 class="fw-bold mb-0 text-dark">Lead Specification</h6>
            </div>
            <div class="card-body">
                <table class="table table-sm table-borderless">
                    <tr>
                        <th class="text-muted w-40">Company:</th>
                        <td class="fw-semibold">@Model.Lead.CompanyName</td>
                    </tr>
                    <tr>
                        <th class="text-muted">Email:</th>
                        <td><a href="mailto:@Model.Lead.Email">@Model.Lead.Email</a></td>
                    </tr>
                    <tr>
                        <th class="text-muted">Phone:</th>
                        <td>@Model.Lead.Phone</td>
                    </tr>
                    <tr>
                        <th class="text-muted">Expected Value:</th>
                        <td class="fw-bold text-success fs-5">$@Model.Lead.ExpectedValue.ToString("N0")</td>
                    </tr>
                    <tr>
                        <th class="text-muted">Lead Source:</th>
                        <td>@Model.Lead.Source</td>
                    </tr>
                    <tr>
                        <th class="text-muted">Created Date:</th>
                        <td>@Model.Lead.CreatedDate.ToString("yyyy-MM-dd HH:mm")</td>
                    </tr>
                </table>

                @if (!string.IsNullOrEmpty(Model.Lead.Notes))
                {
                    <div class="mt-3 p-3 bg-light rounded">
                        <span class="fw-bold small text-muted d-block mb-1">Prospect Notes:</span>
                        <div class="small">@Model.Lead.Notes</div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-md-7">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3 border-bottom">
                <h6 class="fw-bold mb-0 text-dark">Follow-Up History &amp; Actions</h6>
            </div>
            <div class="card-body">
                @if (!Model.FollowUps.Any())
                {
                    <div class="text-center text-muted py-4 small">No follow-ups recorded for this lead yet.</div>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var fu in Model.FollowUps)
                        {
                            <div class="list-group-item px-0 py-2 d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="badge bg-primary me-1">@fu.FollowUpType</span>
                                    <strong class="text-dark small">@fu.Subject</strong>
                                    <div class="text-muted smaller">@fu.Remarks</div>
                                </div>
                                <div class="text-end">
                                    <span class="badge bg-light text-dark border">@fu.FollowUpDate.ToString("yyyy-MM-dd")</span>
                                    <div><span class="smaller text-muted">@fu.Status</span></div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
