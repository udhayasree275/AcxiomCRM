@model AcxiomCRM.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Executive Dashboard";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1 text-dark">
            <i class="bi bi-speedometer2 text-primary me-2"></i>Dashboard
        </h2>
        <div class="text-muted small">
            Scope: <span class="badge bg-secondary">@Model.CurrentUserRole</span> | User: <strong>@Model.CurrentUserName</strong>
        </div>
    </div>

    <!-- Date Range Filter Buttons -->
    <div class="d-flex flex-wrap align-items-center gap-2">
        <div class="btn-group shadow-sm" role="group">
            <a asp-action="Index" asp-route-dateFilter="Today" class="btn btn-sm @(Model.DateFilter.Equals("Today", StringComparison.OrdinalIgnoreCase) ? "btn-primary" : "btn-outline-secondary")">Today</a>
            <a asp-action="Index" asp-route-dateFilter="ThisWeek" class="btn btn-sm @(Model.DateFilter.Equals("ThisWeek", StringComparison.OrdinalIgnoreCase) ? "btn-primary" : "btn-outline-secondary")">This Week</a>
            <a asp-action="Index" asp-route-dateFilter="ThisMonth" class="btn btn-sm @(Model.DateFilter.Equals("ThisMonth", StringComparison.OrdinalIgnoreCase) ? "btn-primary" : "btn-outline-secondary")">This Month</a>
            <a asp-action="Index" asp-route-dateFilter="AllTime" class="btn btn-sm @(Model.DateFilter.Equals("AllTime", StringComparison.OrdinalIgnoreCase) ? "btn-primary" : "btn-outline-secondary")">All Time</a>
        </div>

        <!-- Custom Range Trigger -->
        <button class="btn btn-sm btn-outline-dark" type="button" data-bs-toggle="collapse" data-bs-target="#customDateCollapse">
            <i class="bi bi-calendar3 me-1"></i> Custom
        </button>
    </div>
</div>

<!-- Custom Range Form (Collapsible) -->
<div class="collapse mb-4 @(Model.DateFilter.Equals("Custom", StringComparison.OrdinalIgnoreCase) ? "show" : "")" id="customDateCollapse">
    <div class="card card-body bg-light">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <input type="hidden" name="dateFilter" value="Custom" />
            <div class="col-md-4">
                <label class="form-label small fw-semibold">Start Date</label>
                <input type="date" name="startDate" value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" required />
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-semibold">End Date</label>
                <input type="date" name="endDate" value="@(Model.EndDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" required />
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-primary">Apply Filter</button>
                <a asp-action="Index" asp-route-dateFilter="ThisMonth" class="btn btn-sm btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- 8 KPI Cards -->
<div class="row g-3 mb-4">
    <!-- Total Customers -->
    <div class="col-sm-6 col-xl-3">
        <div class="card kpi-card border-start border-primary border-4 p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold text-uppercase">Total Customers</div>
                    <div class="fs-3 fw-bold text-dark mt-1">@Model.TotalCustomers</div>
                </div>
                <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-circle">
                    <i class="bi bi-people-fill fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Total Leads -->
    <div class="col-sm-6 col-xl-3">
        <div class="card kpi-card border-start border-info border-4 p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold text-uppercase">Total Leads</div>
                    <div class="fs-3 fw-bold text-dark mt-1">@Model.TotalLeads</div>
                    <div class="small text-muted">Open: <strong>@Model.OpenLeads</strong></div>
                </div>
                <div class="bg-info bg-opacity-10 text-info p-3 rounded-circle">
                    <i class="bi bi-funnel-fill fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Total Opportunities -->
    <div class="col-sm-6 col-xl-3">
        <div class="card kpi-card border-start border-warning border-4 p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold text-uppercase">Total Opportunities</div>
                    <div class="fs-3 fw-bold text-dark mt-1">@Model.TotalOpportunities</div>
                    <div class="small text-muted">Open: <strong>@Model.OpenOpportunities</strong></div>
                </div>
                <div class="bg-warning bg-opacity-10 text-warning p-3 rounded-circle">
                    <i class="bi bi-briefcase-fill fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Total Pipeline Value -->
    <div class="col-sm-6 col-xl-3">
        <div class="card kpi-card border-start border-success border-4 p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold text-uppercase">Total Pipeline Value</div>
                    <div class="fs-3 fw-bold text-success mt-1">$@Model.TotalPipelineValue.ToString("N0")</div>
                    <div class="small text-muted">Weighted: <strong>$@Model.WeightedPipelineValue.ToString("N0")</strong></div>
                </div>
                <div class="bg-success bg-opacity-10 text-success p-3 rounded-circle">
                    <i class="bi bi-currency-dollar fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Won Opportunities -->
    <div class="col-sm-6 col-xl-3">
        <div class="card kpi-card p-3 bg-light">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small">Won Deals</span>
                    <h4 class="fw-bold text-success mb-0">@Model.WonOpportunities</h4>
                </div>
                <i class="bi bi-trophy-fill text-success fs-3"></i>
            </div>
        </div>
    </div>

    <!-- Lost Opportunities -->
    <div class="col-sm-6 col-xl-3">
        <div class="card kpi-card p-3 bg-light">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small">Lost Deals</span>
                    <h4 class="fw-bold text-danger mb-0">@Model.LostOpportunities</h4>
                </div>
                <i class="bi bi-x-circle-fill text-danger fs-3"></i>
            </div>
        </div>
    </div>

    <!-- Open Leads Count -->
    <div class="col-sm-6 col-xl-3">
        <div class="card kpi-card p-3 bg-light">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small">Active Open Leads</span>
                    <h4 class="fw-bold text-info mb-0">@Model.OpenLeads</h4>
                </div>
                <i class="bi bi-lightning-charge-fill text-info fs-3"></i>
            </div>
        </div>
    </div>

    <!-- Active Open Opportunities -->
    <div class="col-sm-6 col-xl-3">
        <div class="card kpi-card p-3 bg-light">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small">Active Pipeline Deals</span>
                    <h4 class="fw-bold text-primary mb-0">@Model.OpenOpportunities</h4>
                </div>
                <i class="bi bi-graph-up-arrow text-primary fs-3"></i>
            </div>
        </div>
    </div>
</div>

<!-- Chart.js Visualizations -->
<div class="row g-4 mb-4">
    <!-- Chart 1: Lead Status Doughnut -->
    <div class="col-lg-4">
        <div class="card h-100 shadow-sm">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-pie-chart-fill text-primary me-2"></i>Lead Status Breakdown</h6>
            </div>
            <div class="card-body d-flex align-items-center justify-content-center" style="min-height: 280px;">
                <canvas id="leadStatusChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Chart 2: Pipeline Stages Bar Chart -->
    <div class="col-lg-4">
        <div class="card h-100 shadow-sm">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-bar-chart-steps text-success me-2"></i>Opportunity Pipeline Stages</h6>
            </div>
            <div class="card-body" style="min-height: 280px;">
                <canvas id="pipelineStageChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Chart 3: Monthly Sales Trend Line Chart -->
    <div class="col-lg-4">
        <div class="card h-100 shadow-sm">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-graph-up text-warning me-2"></i>Monthly Sales Revenue</h6>
            </div>
            <div class="card-body" style="min-height: 280px;">
                <canvas id="monthlySalesChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Quick Widgets: Follow-ups and Activities -->
<div class="row g-4 mb-4">
    <!-- Upcoming & Overdue Follow-ups -->
    <div class="col-lg-6">
        <div class="card h-100 shadow-sm">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-alarm-fill text-danger me-2"></i>Follow-Up Reminders</h6>
                <a asp-controller="FollowUps" asp-action="Create" class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-plus-circle me-1"></i> New
                </a>
            </div>
            <div class="card-body p-0">
                <ul class="nav nav-tabs px-3 pt-2" id="followUpTab" role="tablist">
                    <li class="nav-item">
                        <button class="nav-link active small py-1 px-3" data-bs-toggle="tab" data-bs-target="#upcomingTab">Upcoming (@Model.UpcomingFollowUps.Count)</button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link text-danger small py-1 px-3" data-bs-toggle="tab" data-bs-target="#overdueTab">Overdue (@Model.OverdueFollowUps.Count)</button>
                    </li>
                </ul>
                <div class="tab-content p-3">
                    <div class="tab-pane fade show active" id="upcomingTab">
                        @if (!Model.UpcomingFollowUps.Any())
                        {
                            <div class="text-center text-muted py-4 small">No upcoming follow-ups scheduled.</div>
                        }
                        else
                        {
                            <div class="list-group list-group-flush">
                                @foreach (var fu in Model.UpcomingFollowUps)
                                {
                                    <div class="list-group-item px-0 py-2 d-flex justify-content-between align-items-center">
                                        <div>
                                            <span class="badge bg-primary me-1">@fu.FollowUpType</span>
                                            <strong class="text-dark small">@fu.Subject</strong>
                                            <div class="text-muted smaller">
                                                @(fu.Customer != null ? fu.Customer.CustomerName : fu.Lead?.LeadName ?? "General")
                                            </div>
                                        </div>
                                        <div class="text-end">
                                            <span class="badge bg-light text-dark border">@fu.FollowUpDate.ToString("MMM dd, yyyy")</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                    <div class="tab-pane fade" id="overdueTab">
                        @if (!Model.OverdueFollowUps.Any())
                        {
                            <div class="text-center text-success py-4 small"><i class="bi bi-check-circle me-1"></i>No overdue follow-ups!</div>
                        }
                        else
                        {
                            <div class="list-group list-group-flush">
                                @foreach (var fu in Model.OverdueFollowUps)
                                {
                                    <div class="list-group-item px-0 py-2 d-flex justify-content-between align-items-center">
                                        <div>
                                            <span class="badge bg-danger me-1">@fu.FollowUpType</span>
                                            <strong class="text-dark small">@fu.Subject</strong>
                                            <div class="text-muted smaller">@(fu.Customer != null ? fu.Customer.CustomerName : fu.Lead?.LeadName ?? "")</div>
                                        </div>
                                        <div class="text-end">
                                            <span class="badge bg-danger">@fu.FollowUpDate.ToString("MMM dd") (Overdue)</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Activities -->
    <div class="col-lg-6">
        <div class="card h-100 shadow-sm">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-clock-history text-primary me-2"></i>Recent Activities</h6>
                <a asp-controller="Activities" asp-action="Create" class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-plus-circle me-1"></i> Log Activity
                </a>
            </div>
            <div class="card-body p-3">
                @if (!Model.RecentActivities.Any())
                {
                    <div class="text-center text-muted py-4 small">No recent activities logged.</div>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var act in Model.RecentActivities)
                        {
                            <div class="list-group-item px-0 py-2 d-flex justify-content-between align-items-start">
                                <div>
                                    <span class="badge bg-secondary me-1">@act.ActivityType</span>
                                    <strong class="text-dark small">@act.Subject</strong>
                                    @if (!string.IsNullOrEmpty(act.Description))
                                    {
                                        <div class="text-muted smaller">@act.Description</div>
                                    }
                                </div>
                                <span class="text-muted smaller">@act.ActivityDate.ToString("MMM dd, HH:mm")</span>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", function () {
        // 1. Lead Status Doughnut Chart
        const leadCtx = document.getElementById('leadStatusChart').getContext('2d');
        new Chart(leadCtx, {
            type: 'doughnut',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LeadStatusLabels)),
                datasets: [{
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LeadStatusCounts)),
                    backgroundColor: ['#0ea5e9', '#3b82f6', '#10b981', '#ef4444', '#8b5cf6'],
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'bottom' }
                }
            }
        });

        // 2. Pipeline Stages Bar Chart
        const pipelineCtx = document.getElementById('pipelineStageChart').getContext('2d');
        new Chart(pipelineCtx, {
            type: 'bar',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PipelineStageLabels)),
                datasets: [{
                    label: 'Deal Count',
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PipelineStageCounts)),
                    backgroundColor: '#3b82f6',
                    borderRadius: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: { beginAtZero: true, ticks: { precision: 0 } }
                },
                plugins: {
                    legend: { display: false }
                }
            }
        });

        // 3. Monthly Sales Line Chart
        const salesCtx = document.getElementById('monthlySalesChart').getContext('2d');
        new Chart(salesCtx, {
            type: 'line',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlySalesLabels)),
                datasets: [{
                    label: 'Won Revenue ($)',
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlySalesAmounts)),
                    borderColor: '#10b981',
                    backgroundColor: 'rgba(16, 185, 129, 0.1)',
                    fill: true,
                    tension: 0.3,
                    borderWidth: 2,
                    pointRadius: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: { beginAtZero: true }
                }
            }
        });
    });
</script>
}
