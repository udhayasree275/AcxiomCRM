@model AcxiomCRM.ViewModels.UserListViewModel
@{
    ViewData["Title"] = "User & Role Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1 text-dark"><i class="bi bi-person-gear text-primary me-2"></i>User &amp; Role Administration</h2>
        <span class="text-muted small">Manage CRM application users, assigned roles, security status and lockouts</span>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-person-plus-fill me-1"></i> Add New User
    </a>
</div>

<!-- Search & Role Filter -->
<div class="card mb-4 shadow-sm border-0">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-6">
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@Model.SearchTerm" class="form-control" placeholder="Search by name, email..." />
                </div>
            </div>
            <div class="col-md-3">
                <select name="role" class="form-select">
                    <option value="">All Roles</option>
                    <option value="Admin" selected="@(Model.RoleFilter == "Admin")">Admin</option>
                    <option value="Manager" selected="@(Model.RoleFilter == "Manager")">Manager</option>
                    <option value="SalesExecutive" selected="@(Model.RoleFilter == "SalesExecutive")">Sales Executive</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-outline-primary">Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Users Table -->
<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>User</th>
                    <th>Email Address</th>
                    <th>Role</th>
                    <th>Account Status</th>
                    <th>Lockout Status</th>
                    <th>Failed Attempts</th>
                    <th>Created</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model.Users)
                {
                    <tr>
                        <td class="fw-semibold text-dark">@u.FullName</td>
                        <td>@u.Email</td>
                        <td>
                            @if (u.Role == "Admin") { <span class="badge bg-danger">Admin</span> }
                            else if (u.Role == "Manager") { <span class="badge bg-primary">Manager</span> }
                            else { <span class="badge bg-success">Sales Executive</span> }
                        </td>
                        <td>
                            @if (u.IsActive)
                            {
                                <span class="badge bg-success-subtle text-success border border-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Deactivated</span>
                            }
                        </td>
                        <td>
                            @if (u.IsLockedOut)
                            {
                                <span class="badge bg-danger"><i class="bi bi-lock-fill me-1"></i>Locked Out</span>
                                <div class="smaller text-muted">Until @u.LockoutEnd?.ToString("HH:mm:ss")</div>
                            }
                            else
                            {
                                <span class="badge bg-light text-success border">Unlocked</span>
                            }
                        </td>
                        <td>
                            @if (u.AccessFailedCount > 0)
                            {
                                <span class="badge bg-warning text-dark">@u.AccessFailedCount / 5</span>
                            }
                            else
                            {
                                <span class="text-muted small">0</span>
                            }
                        </td>
                        <td class="small text-muted">@u.CreatedDate.ToString("yyyy-MM-dd")</td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-outline-primary" title="Edit User">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="ResetPassword" asp-route-id="@u.Id" class="btn btn-outline-warning" title="Reset Password">
                                    <i class="bi bi-key"></i>
                                </a>
                                @if (u.IsLockedOut)
                                {
                                    <form asp-action="Unlock" asp-route-id="@u.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-success" title="Unlock Account">
                                            <i class="bi bi-unlock-fill"></i> Unlock
                                        </button>
                                    </form>
                                }
                                <form asp-action="ToggleStatus" asp-route-id="@u.Id" method="post" class="d-inline" onsubmit="return confirm('Toggle status for this user?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-secondary" title="@(u.IsActive ? "Deactivate" : "Activate")">
                                        <i class="bi @(u.IsActive ? "bi-slash-circle text-danger" : "bi-check-circle text-success")"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
