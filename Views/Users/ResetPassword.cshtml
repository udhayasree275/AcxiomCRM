@model AcxiomCRM.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = $"Reset Password - {Model.UserEmail}";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-key-fill text-warning me-2"></i>Reset Password</h5>
                <span class="small text-muted">User: <strong>@Model.UserEmail</strong></span>
            </div>
            <div class="card-body p-4">
                <form asp-action="ResetPassword" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="UserId" />
                    <input type="hidden" asp-for="UserEmail" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label fw-semibold small required"></label>
                        <input asp-for="NewPassword" class="form-control" placeholder="••••••••" />
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        <div class="form-text small">At least 8 characters with upper, lower, digit &amp; symbol.</div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="form-label fw-semibold small required"></label>
                        <input asp-for="ConfirmPassword" class="form-control" placeholder="••••••••" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-warning px-4 fw-semibold">
                            <i class="bi bi-shield-lock me-1"></i> Update Password
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
