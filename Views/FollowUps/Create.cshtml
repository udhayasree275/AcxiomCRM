@model AcxiomCRM.ViewModels.FollowUpEditViewModel
@{
    ViewData["Title"] = "Schedule Follow-Up";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-calendar-plus text-primary me-2"></i>Schedule Follow-Up Activity</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post" id="fuForm">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FollowUpType" class="form-label fw-semibold small required"></label>
                            <select asp-for="FollowUpType" class="form-select">
                                <option value="Call">Call</option>
                                <option value="Meeting">Meeting</option>
                                <option value="Email">Email</option>
                                <option value="Task">Task / Demo</option>
                            </select>
                            <span asp-validation-for="FollowUpType" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="FollowUpDate" class="form-label fw-semibold small required"></label>
                            <input asp-for="FollowUpDate" class="form-control" type="datetime-local" min="@DateTime.UtcNow.ToString("yyyy-MM-ddTHH:mm")" id="fuDateInput" />
                            <span asp-validation-for="FollowUpDate" class="text-danger small"></span>
                            <div class="form-text small">Cannot be earlier than today.</div>
                        </div>

                        <div class="col-12">
                            <label asp-for="Subject" class="form-label fw-semibold small required"></label>
                            <input asp-for="Subject" class="form-control" placeholder="e.g. Discuss revised quote terms" />
                            <span asp-validation-for="Subject" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CustomerId" class="form-label fw-semibold small"></label>
                            <select asp-for="CustomerId" asp-items="Model.Customers" class="form-select">
                                <option value="">-- None (Lead Activity) --</option>
                            </select>
                            <span asp-validation-for="CustomerId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="LeadId" class="form-label fw-semibold small"></label>
                            <select asp-for="LeadId" asp-items="Model.Leads" class="form-select">
                                <option value="">-- None (Customer Activity) --</option>
                            </select>
                            <span asp-validation-for="LeadId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Status" class="form-label fw-semibold small required"></label>
                            <select asp-for="Status" class="form-select">
                                <option value="Planned">Planned</option>
                                <option value="Completed">Completed</option>
                                <option value="Missed">Missed</option>
                                <option value="Cancelled">Cancelled</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="AssignedTo" class="form-label fw-semibold small required"></label>
                            <select asp-for="AssignedTo" asp-items="Model.SalesExecutives" class="form-select"></select>
                            <span asp-validation-for="AssignedTo" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Remarks" class="form-label fw-semibold small required"></label>
                            <textarea asp-for="Remarks" class="form-control" rows="3" placeholder="Context, agenda, prep instructions..."></textarea>
                            <span asp-validation-for="Remarks" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4 fw-semibold">
                            <i class="bi bi-calendar-check me-1"></i> Save Follow-Up
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
