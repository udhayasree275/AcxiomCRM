@model AcxiomCRM.Models.Opportunity
@{
    ViewData["Title"] = $"{Model.OpportunityName} - Opportunity";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h2 class="fw-bold mb-0 text-dark">@Model.OpportunityName</h2>
            @if (Model.Stage == "Won") { <span class="badge bg-success fs-6">Won</span> }
            else if (Model.Stage == "Lost") { <span class="badge bg-danger fs-6">Lost</span> }
            else { <span class="badge bg-primary fs-6">@Model.Stage</span> }
        </div>
        <div class="text-muted small mt-1">
            Customer: <strong>@(Model.Customer?.CustomerName ?? "None")</strong> | Owner: <strong>@(Model.AssignedUser?.FullName ?? "Unassigned")</strong>
        </div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.OpportunityId" class="btn btn-outline-primary">
            <i class="bi bi-pencil me-1"></i> Edit
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
    </div>
</div>

<!-- Stage Progression Pipeline Bar -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-4">
        <h6 class="fw-bold text-dark text-uppercase small mb-3">Pipeline Stage Transition</h6>
        <div class="d-flex flex-wrap gap-2">
            @foreach (var stage in new[] { "Qualification", "Proposal", "Negotiation", "Won", "Lost" })
            {
                <form asp-action="UpdateStage" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.OpportunityId" />
                    <input type="hidden" name="stage" value="@stage" />
                    <button type="submit" class="btn btn-sm @(Model.Stage == stage ? "btn-primary fw-bold" : "btn-outline-secondary")">
                        @if (Model.Stage == stage) { <i class="bi bi-check-circle-fill me-1"></i> }
                        @stage
                    </button>
                </form>
            }
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Financial Metrics -->
    <div class="col-md-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3 border-bottom">
                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-cash-stack text-success me-2"></i>Financial Calculation</h6>
            </div>
            <div class="card-body">
                <table class="table table-sm table-borderless">
                    <tr>
                        <th class="text-muted w-50">Deal Amount:</th>
                        <td class="fs-4 fw-bold text-dark">$@Model.Amount.ToString("N0")</td>
                    </tr>
                    <tr>
                        <th class="text-muted">Win Probability:</th>
                        <td class="fs-5 fw-semibold text-primary">@Model.Probability%</td>
                    </tr>
                    <tr class="border-top">
                        <th class="text-muted">Weighted Pipeline Value:</th>
                        <td class="fs-4 fw-bold text-success">$@Model.WeightedAmount.ToString("N0")</td>
                    </tr>
                </table>
                <div class="p-3 bg-light rounded small text-muted">
                    <i class="bi bi-info-circle me-1 text-info"></i>
                    Formula: <code>Amount ($@Model.Amount.ToString("N0")) &times; Probability (@Model.Probability%) / 100 = $@Model.WeightedAmount.ToString("N0")</code>
                </div>
            </div>
        </div>
    </div>

    <!-- Timeline & Associated Records -->
    <div class="col-md-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3 border-bottom">
                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-calendar-event text-primary me-2"></i>Timeline &amp; Relations</h6>
            </div>
            <div class="card-body">
                <table class="table table-sm table-borderless">
                    <tr>
                        <th class="text-muted w-40">Expected Close:</th>
                        <td class="fw-semibold">@Model.ExpectedCloseDate.ToString("yyyy-MM-dd")</td>
                    </tr>
                    <tr>
                        <th class="text-muted">Created Date:</th>
                        <td>@Model.CreatedDate.ToString("yyyy-MM-dd HH:mm")</td>
                    </tr>
                    <tr>
                        <th class="text-muted">Originating Lead:</th>
                        <td>@(Model.Lead != null ? $"{Model.Lead.LeadName} ({Model.Lead.LeadCode})" : "None (Direct)")</td>
                    </tr>
                    <tr>
                        <th class="text-muted">Status:</th>
                        <td><span class="badge bg-light text-dark border">@Model.Status</span></td>
                    </tr>
                </table>

                @if (!string.IsNullOrEmpty(Model.Notes))
                {
                    <div class="p-3 bg-light rounded mt-3">
                        <span class="fw-bold small text-muted d-block mb-1">Deal Notes:</span>
                        <div class="small">@Model.Notes</div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
