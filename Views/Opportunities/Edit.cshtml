@model AcxiomCRM.ViewModels.OpportunityEditViewModel
@{
    ViewData["Title"] = $"Edit {Model.OpportunityName}";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-pencil-square text-primary me-2"></i>Edit Opportunity</h5>
                <span class="badge bg-light text-dark border">ID: @Model.OpportunityId</span>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="OpportunityId" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-12">
                            <label asp-for="OpportunityName" class="form-label fw-semibold small required"></label>
                            <input asp-for="OpportunityName" class="form-control" />
                            <span asp-validation-for="OpportunityName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CustomerId" class="form-label fw-semibold small required"></label>
                            <select asp-for="CustomerId" asp-items="Model.Customers" class="form-select"></select>
                            <span asp-validation-for="CustomerId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="LeadId" class="form-label fw-semibold small"></label>
                            <select asp-for="LeadId" asp-items="Model.Leads" class="form-select">
                                <option value="">-- None (Direct Customer Deal) --</option>
                            </select>
                            <span asp-validation-for="LeadId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Amount" class="form-label fw-semibold small required"></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="Amount" class="form-control" type="number" step="0.01" min="0.01" id="amountInput" />
                            </div>
                            <span asp-validation-for="Amount" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Probability" class="form-label fw-semibold small required"></label>
                            <div class="input-group">
                                <input asp-for="Probability" class="form-control" type="number" min="0" max="100" id="probInput" />
                                <span class="input-group-text">%</span>
                            </div>
                            <span asp-validation-for="Probability" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold small">Derived Weighted Value</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light">$</span>
                                <input type="text" id="weightedPreview" class="form-control bg-light" readonly />
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Stage" class="form-label fw-semibold small required"></label>
                            <select asp-for="Stage" class="form-select" id="stageSelect">
                                <option value="Qualification">Qualification</option>
                                <option value="Proposal">Proposal</option>
                                <option value="Negotiation">Negotiation</option>
                                <option value="Won">Won</option>
                                <option value="Lost">Lost</option>
                            </select>
                            <span asp-validation-for="Stage" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ExpectedCloseDate" class="form-label fw-semibold small required"></label>
                            <input asp-for="ExpectedCloseDate" class="form-control" type="date" />
                            <span asp-validation-for="ExpectedCloseDate" class="text-danger small"></span>
                        </div>

                        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                        {
                            <div class="col-md-12">
                                <label asp-for="AssignedTo" class="form-label fw-semibold small"></label>
                                <select asp-for="AssignedTo" asp-items="Model.SalesExecutives" class="form-select">
                                    <option value="">-- Assign Sales Executive --</option>
                                </select>
                                <span asp-validation-for="AssignedTo" class="text-danger small"></span>
                            </div>
                        }
                        else
                        {
                            <input type="hidden" asp-for="AssignedTo" />
                        }

                        <div class="col-12">
                            <label asp-for="Notes" class="form-label fw-semibold small"></label>
                            <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Notes" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Details" asp-route-id="@Model.OpportunityId" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4 fw-semibold">
                            <i class="bi bi-save me-1"></i> Update Opportunity
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function updateWeighted() {
            const amt = parseFloat(document.getElementById('amountInput').value) || 0;
            const prob = parseFloat(document.getElementById('probInput').value) || 0;
            const weighted = (amt * prob) / 100;
            document.getElementById('weightedPreview').value = weighted.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }
        document.getElementById('amountInput').addEventListener('input', updateWeighted);
        document.getElementById('probInput').addEventListener('input', updateWeighted);
        updateWeighted();
    </script>
}
